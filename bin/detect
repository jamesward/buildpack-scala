#!/usr/bin/env bash
# Heroku classic buildpack: detect
# Usage: bin/detect <BUILD_DIR>
#
# Succeeds when BUILD_DIR looks like an sbt project with a project-local
# `./sbta` (preferred) or `./sbt` launcher (sbt-native-packager + JavaAppPackaging,
# or sbt-native-image for native image mode, is then assumed).
set -euo pipefail

BUILD_DIR=${1:-}

if [[ -z $BUILD_DIR ]]; then
  echo "usage: bin/detect <BUILD_DIR>" >&2
  exit 1
fi

if [[ -f "$BUILD_DIR/build.sbt" && ( -f "$BUILD_DIR/sbta" || -f "$BUILD_DIR/sbt" ) ]]; then
  if grep -qs 'sbt-native-image' "$BUILD_DIR"/project/*.sbt; then
    echo "Scala (sbt-native-image)"
  else
    echo "Scala (sbt-native-packager)"
  fi
  exit 0
fi

exit 1
